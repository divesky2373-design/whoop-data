# WHOOP Developer App credentials
# Get these from https://developer.whoop.com/
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Anthropic API key
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Agent-to-Agent Transaction Volume Monitor
# Dune Analytics API key (for x402 protocol data)
# Get from https://dune.com/settings/api
# DUNE_API_KEY=your_dune_api_key_here

# Basescan API key (for on-chain USDC transfers between agents)
# Get from https://basescan.org/myapikey
# BASESCAN_API_KEY=your_basescan_api_key_here

# Optional settings
# VOLUME_DB_PATH=~/.whoop_agent_volume.db
# CHART_OUTPUT_DIR=./charts
