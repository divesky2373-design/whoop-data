# WHOOP Developer App credentials
# Get these from https://developer.whoop.com/
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Anthropic API key
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Agent Trading Volume Monitor (optional)
# CoinGecko API key (optional - free tier works without it)
# COINGECKO_API_KEY=your_coingecko_api_key_here
# VOLUME_DB_PATH=~/.whoop_agent_volume.db
# CHART_OUTPUT_DIR=./charts
